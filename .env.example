# =============================================================================
# Mindora AI — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed for your environment.
# =============================================================================

# Server Environment & Port
ENVIRONMENT=development
PORT=5000

# SQLite Database Location
DATABASE_URL=sqlite:///./mindora.db
DATABASE_PATH=./mindora.db

# Authentication & Security
# WARNING: Always generate a high-entropy secret in production (e.g., openssl rand -hex 32)
JWT_SECRET=change_me_to_a_secure_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Allowed Cross-Origin Resource Sharing (CORS) Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:5173

# AI & External Provider Keys
# Optional: Mindora provides built-in fallback tutor responses if unset
ANTHROPIC_API_KEY=your_anthropic_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000
